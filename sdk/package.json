{
  "name": "@skur/sdk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js"
    },
    "./src/*": "./src/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "tsc -p tsconfig.build.json",
    "seed": "node --experimental-strip-types scripts/seed.ts",
    "e2e": "node --experimental-strip-types scripts/e2e.ts"
  },
  "dependencies": {
    "@mysten/sui": "^2.34.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "~6.0.2",
    "vitest": "^3.2.7"
  },
  "files": [
    "dist",
    "src"
  ]
}