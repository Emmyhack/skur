{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "paths": { "@web/*": ["../web/src/*"] }
  },
  "include": ["**/*.ts", "**/*.tsx", "../web/src/lib/**/*.ts", "../web/src/abi/*.ts", "../web/src/config/*.ts"],
  "exclude": ["node_modules", "../web/src/lib/*.test.ts", "../web/src/lib/motion.ts"]
}
