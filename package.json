{
  "name": "skur",
  "private": true,
  "version": "0.1.0",
  "description": "A programmable authorization and treasury security layer for Sui organizations.",
  "scripts": {
    "move:build": "cd sui && sui move build",
    "move:test": "cd sui && sui move test",
    "move:publish": "cd sui && scripts/publish.sh",
    "sdk:build": "cd sdk && npm run build",
    "sdk:test": "cd sdk && npm test",
    "server:migrate": "cd server && npm run migrate",
    "server:dev": "cd server && npm run dev",
    "app:dev": "cd app && npm run dev",
    "app:build": "cd app && npm run build",
    "test": "npm run move:test && npm run sdk:test",
    "typecheck": "cd sdk && npm run typecheck && cd ../server && npm run typecheck && cd ../app && npm run typecheck && cd ../mobile && npm run typecheck",
    "sui:seed": "cd sdk && npm run seed",
    "sui:e2e": "cd sdk && npm run e2e",
    "verify": "scripts/verify.sh",
    "mobile:start": "cd mobile && npm start",
    "mobile:ios": "cd mobile && npm run ios",
    "mobile:android": "cd mobile && npm run android"
  }
}