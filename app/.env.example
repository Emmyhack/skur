# Which network, and the package published on it. Both override sui/deployments/<network>.json.
NEXT_PUBLIC_SKUR_NETWORK=testnet
NEXT_PUBLIC_SKUR_PACKAGE_ID=0x0

# A gRPC endpoint other than the public full node.
# NEXT_PUBLIC_SKUR_GRPC_URL=https://fullnode.testnet.sui.io:443

# The indexer. Optional: every screen works without it, with fewer round trips saved.
# NEXT_PUBLIC_SKUR_API=http://localhost:8787
