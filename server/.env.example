# Postgres
DATABASE_URL=postgres://localhost:5432/skur

# Which network to index, and the published package on it.
SKUR_NETWORK=testnet
SKUR_PACKAGE_ID=0x0

# Optional: a gRPC endpoint other than the public full node.
# SKUR_GRPC_URL=https://fullnode.testnet.sui.io:443

# How often the indexer asks for new events, in milliseconds.
INDEX_INTERVAL_MS=4000

PORT=8787
